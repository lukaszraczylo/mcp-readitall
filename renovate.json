{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "chromedp pins an exact cdproto; bump them together",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/chromedp/chromedp", "github.com/chromedp/cdproto"],
      "groupName": "chromedp"
    }
  ]
}
